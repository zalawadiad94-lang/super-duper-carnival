# Angel One SmartAPI credentials for live NSE and MCX data.
#
# SETUP
#   1. Sign in at https://smartapi.angelbroking.com and create an app (free).
#      That gives you the API key.
#   2. On the same site, enable TOTP. It shows a long SECRET string once —
#      copy that. Not the 6-digit code, which expires every 30 seconds.
#   3. Rename this file from ".env.example" to ".env" and fill in the values
#      below. No quotes needed.
#   4. Restart the app.
#
# This file is your trading account. Never share it or commit it to git.
# It is already listed in .gitignore.

ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
